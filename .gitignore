# Build outputs — artifacts are released via CI, never committed
out/
build/
*.tar
*.tar.gz
*.tar.xz
*.wsl
bzImage
*.vhdx

# Kernel build tree (cloned by kernel/build.sh)
kernel/WSL2-Linux-Kernel/

# Rootfs build workspace
rootfs/work/

# Android images are never committed (size + GApps licensing, ADR-004)
*.img
system.img
vendor.img

# Local scratch
*.log
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Wizard bitmaps are generated from assets/windroid.svg by scripts/make-icons.sh
# (the .ico IS committed - the rootfs build and installer need it)
assets/wizard-*.bmp

# Scratch dropbox for images/files handed over during a session
.filedump/
